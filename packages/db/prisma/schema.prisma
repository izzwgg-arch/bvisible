// B Visible — auth + tenant foundation + estimate foundation
// + purchase order foundation + vendor email ingestion foundation.
// Foundation models: Tenant, User, Role, Session, UserInvite,
// PasswordResetToken, AuditLog.
// Estimate foundation: Client, Machine, Estimate, EstimateLineItem
// + EstimateStatus / EstimateLineKind enums.
// PO foundation: Vendor, PurchaseOrder, POLineItem, POAttachment,
// POEvent + POStatus / POLineKind / POAttachmentKind / POEventKind
// enums. EstimateStatus.FINALIZED is gated by R-EST-04 in
// apps/web/app/(app)/estimates/[id]/actions.ts (finalizeEstimateAction).
// Email ingestion foundation: TenantEmailInbox (1:1 per tenant),
// IngestedEmail, IngestedEmailAttachment, EmailIngestRun
// + EmailIngestStatus / EmailMatchReason enums; POAttachment.kind gets
// EMAIL_ATTACHMENT and POEvent.kind gets VENDOR_REPLY so an ingested
// email materialises into a PO timeline entry + attachment rows.
// See docs/ai-context/DATA_MODEL.md for the target model set,
// docs/ai-context/ESTIMATE_ENGINE.md for the pricing rules,
// docs/ai-context/PO_SYSTEM.md for the PO workflow, and
// docs/ai-context/EMAIL_INGESTION.md for the ingestion contract.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

// FINALIZED is the terminal "this estimate is locked because money is
// being spent against it" status. R-EST-04: an estimate can only enter
// FINALIZED via finalizeEstimateAction, which requires at least one
// linked PurchaseOrder with a non-null qboPoNumber. updateEstimateStatusAction
// refuses FINALIZED directly.
enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  FINALIZED
}

// One row per editable line in the spreadsheet-style estimate editor.
// `kind` discriminates which subtotal bucket the line rolls into.
// DESIGN/INSTALL exist as kinds (in addition to the per-estimate
// design flat fee) so estimators can add multiple design or install
// lines if a job needs them. See packages/pricing/src/estimate.ts.
enum EstimateLineKind {
  MATERIAL
  MACHINE
  LABOR
  DESIGN
  INSTALL
  MISC
}

/// Append-only estimate timeline (distinct from POEvent). Public quote
/// accept/decline writes QUOTE_* kinds from `/quote/[token]`.
enum EstimateTimelineKind {
  QUOTE_ACCEPTED
  QUOTE_DECLINED
}

/// Units for Items catalog / estimate hints (shop-facing labels).
enum ShopCatalogUnit {
  EACH
  SHEET
  SQ_FT
  HOUR
  LINEAR_FT
  ROLL
  CUSTOM
}

// Purchase order lifecycle. Kept deliberately small for the foundation:
// no approvals, no PARTIAL_RECEIVED splits across line items, no
// vendor-side acceptance state. POEvent rows tell the full story.
enum POStatus {
  DRAFT
  SENT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELED
}

// Mirrors EstimateLineKind so estimate→PO conversion preserves the
// kind label without lossy mapping. Estimators see the same vocabulary
// on both sides of the handoff.
enum POLineKind {
  MATERIAL
  MACHINE
  LABOR
  DESIGN
  INSTALL
  MISC
}

// Coarse classification of an attachment for filtering/icons in the UI.
// The kind is set at upload time; magic-byte MIME detection happens
// independently in apps/web/lib/po/uploads.ts.
// EMAIL_ATTACHMENT is reserved for files that arrived via the inbound
// email pipeline (apps/web/lib/email-ingest/*); rows of that kind also
// carry a non-null sourceEmailId so the UI can deep-link back to the
// review surface.
enum POAttachmentKind {
  RECEIPT
  INVOICE
  VENDOR_INVOICE
  INSTALL_PHOTO
  FIELD_DOCUMENT
  VENDOR_DOC
  DRAWING
  OTHER
  EMAIL_ATTACHMENT
}

// POEvent.kind drives the human-readable timeline. Only the kinds we
// actually emit today are listed; new kinds (mobile_receipt) land with
// their respective phases. See docs/ai-context/PO_SYSTEM.md.
// VENDOR_REPLY is emitted by the email ingestion foundation when a
// matched inbound email materialises onto a PO; the row also carries
// a non-null sourceEmailId for cross-link.
// VENDOR_LOWER_PRICE is emitted when deterministic extraction detects
// a unit/list price strictly lower than this vendor+SKU's prior history
// row (operational signal only — no auto-repricing). See R-VEN-03.
enum POEventKind {
  CREATED
  CREATED_FROM_ESTIMATE
  LINES_SAVED
  STATUS_CHANGED
  QBO_NUMBER_ASSIGNED
  VENDOR_ASSIGNED
  ATTACHMENT_ADDED
  ATTACHMENT_DELETED
  NOTE_ADDED
  CANCELED
  VENDOR_REPLY
  VENDOR_LOWER_PRICE
}

// Deterministic email/snippet/filename price extraction (Phase 10).
// Not probabilistic; values stored on VendorPriceHistory rows.
enum VendorPriceConfidence {
  HIGH
  MEDIUM
  LOW
}

enum VendorPriceExtractionMethod {
  LINE_REGEX
  SUBJECT_REGEX
  FILENAME_REGEX
  /// Deterministic regex scan over locally OCR'd plain text (pre-review).
  OCR_TEXT_REGEX
  /// Operator-approved observation written after OCR review (source of truth path).
  OCR_APPROVED
  /// Operator-entered unit price from Items catalog (append-only history).
  MANUAL
}

// Async OCR receipt / invoice understanding (Phase 13). OCR output is never
// authoritative until an operator confirms — see docs/ai-context/VENDOR_PRICE_ENGINE.md.
enum OcrJobStatus {
  PENDING
  PROCESSING
  REVIEW_REQUIRED
  CONFIRMED
  REJECTED
  FAILED
}

// IngestedEmail.status — the per-email processing state. PENDING is the
// initial write inside the tick. UNMATCHED means the matcher returned
// no PO and the row needs operator review. MATCHED means the matcher
// linked to a PO and the email is fully processed. FAILED means an
// exception happened mid-process; retry from the review screen.
// DISMISSED means an operator chose not to attach; the row stays for
// audit and the IMAP message stays \Seen.
enum EmailIngestStatus {
  PENDING
  MATCHED
  UNMATCHED
  FAILED
  DISMISSED
}

// EmailMatchReason explains how/why an IngestedEmail was matched (or
// not). Stored on every row including unmatched/dismissed so support
// can audit the matcher's decision without rerunning it.
//   QBO_NUMBER         exact match on PurchaseOrder.qboPoNumber
//   PO_NUMBER          exact match on PurchaseOrder.number (PO-NNNNNN)
//   VENDOR_AND_RECENT  unique open PO for the sender's vendor in 30d
//   MANUAL             operator linked from /admin/email-ingestion
//   NONE               no match (review queue)
enum EmailMatchReason {
  QBO_NUMBER
  PO_NUMBER
  VENDOR_AND_RECENT
  MANUAL
  NONE
}

// Snapshot reconciliation state between POLineItem expectations and
// operator-approved OCR-backed VendorPriceHistory rows on this PO.
// Append-only runs — replay deduped via triggerDedupeKey (see run.ts).
enum POReconciliationStatus {
  PENDING
  PARTIAL
  MATCHED
  VARIANCE
  REVIEW_REQUIRED
  RESOLVED
}

enum POReconciliationLineMatch {
  MATCHED
  PRICE_VARIANCE
  QTY_VARIANCE
  PRICE_AND_QTY_VARIANCE
  UNMATCHED_PO_LINE
  UNMATCHED_RECEIPT_LINE
  AMBIGUOUS_PO_LINE
  AMBIGUOUS_RECEIPT_LINE
}

enum POReconciliationLineResolution {
  NONE
  CONFIRMED_PAIR
  ACCEPTED_VARIANCE
  REJECTED_PAIR
}

enum SpendAlertKind {
  PRICE_OVER_PO_EXPECTED
  QTY_MISMATCH
  UNMATCHED_RECEIPT_LINE
  MISSING_PO_RECEIPT_LINE
  RECONCILIATION_AMBIGUOUS
  PO_TOTAL_OVER_EXPECTED
}

enum SpendAlertStatus {
  OPEN
  DISMISSED
  SUPERSEDED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  invites      UserInvite[]
  clients      Client[]
  machines     Machine[]
  estimates    Estimate[]
  lineItems    EstimateLineItem[]
  vendors      Vendor[]
  purchaseOrders PurchaseOrder[]
  poLineItems  POLineItem[]
  poAttachments POAttachment[]
  poEvents     POEvent[]
  emailInbox            TenantEmailInbox?
  ingestedEmails        IngestedEmail[]
  ingestedEmailAttachments IngestedEmailAttachment[]
  emailIngestRuns       EmailIngestRun[]
  vendorCatalogItems  VendorCatalogItem[]
  vendorItemAliases   VendorItemAlias[]
  vendorPriceHistories VendorPriceHistory[]
  vendorPriceNotifications VendorPriceNotification[]
  mobileSessions       MobileSession[]
  mobilePendingUploads MobilePendingUpload[]
  ocrDocuments         OcrDocument[]
  poReconciliations    POReconciliation[]
  poReconciliationLines POReconciliationLine[]
  spendAlerts          SpendAlert[]
  shopMaterialItems    ShopMaterialItem[]
  shopMaterialItemAliases ShopMaterialItemAlias[]
  estimateQuoteLinks       EstimateQuoteLink[]
  estimateTimelineEvents EstimateTimelineEvent[]

  @@map("tenants")
}

model User {
  id           String  @id @default(cuid())
  tenantId     String?
  email        String
  name         String?
  role         Role    @default(USER)
  passwordHash String?

  // Auth lifecycle. All nullable so we can model invited-but-not-accepted
  // and disabled-but-not-deleted accounts without sentinels.
  lastLoginAt       DateTime?
  disabledAt        DateTime?
  invitedAt         DateTime?
  inviteAcceptedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions          Session[]
  resetTokens       PasswordResetToken[]
  invitesIssued     UserInvite[]         @relation("UserInviteInviter")
  estimatesCreated  Estimate[]           @relation("EstimateCreator")
  purchaseOrdersCreated PurchaseOrder[]  @relation("POCreator")
  poAttachmentsUploaded POAttachment[]   @relation("POAttachmentUploader")
  poEventsAuthored  POEvent[]            @relation("POEventActor")
  mobileSessions    MobileSession[]
  mobilePendingUploads MobilePendingUpload[]
  ocrDocumentsConfirmed OcrDocument[]    @relation("OcrDocumentConfirmedBy")
  ocrDocumentsRejected  OcrDocument[]    @relation("OcrDocumentRejectedBy")
  purchaseOrdersMarkedReconciled PurchaseOrder[] @relation("PoMarkedReconciledBy")
  poReconciliationsResolved       POReconciliation[]       @relation("POReconciliationResolvedBy")
  poReconciliationLinesResolved   POReconciliationLine[] @relation("POReconciliationLineResolvedBy")
  spendAlertsDismissed            SpendAlert[]             @relation("SpendAlertDismissedBy")
  spendAlertsResolvedSpend        SpendAlert[]             @relation("SpendAlertResolvedBy")
  estimateQuoteLinksCreated       EstimateQuoteLink[]      @relation("QuoteLinkCreator")

  // SUPER_ADMIN users have tenantId = null. The migration adds a partial
  // unique index `users_email_super_admin_key` ON users(email) WHERE
  // "tenantId" IS NULL so two SUPER_ADMINs cannot share an email (the
  // composite @@unique below treats NULLs as distinct in Postgres).
  // Tenant users are unique on (tenantId, email).
  @@unique([tenantId, email], name: "tenant_email_unique")
  @@index([tenantId])
  @@index([role])
  @@map("users")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  ipAddress  String?
  userAgent  String?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Mobile API (Bearer JWT + rotating refresh). Browser sessions use
// `Session` + cookie; this table is exclusively for /api/v1/* callers.
model MobileSession {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  deviceLabel      String?   @db.VarChar(120)
  lastUsedAt       DateTime  @default(now())
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([userId, revokedAt])
  @@map("mobile_sessions")
}

// Two-phase mobile upload: presign allocates storageKey + expiry; client
// PUTs bytes to /api/v1/uploads/[id]/bytes; complete verifies magic MIME
// and inserts POAttachment + POEvent.
model MobilePendingUpload {
  id                String           @id @default(cuid())
  tenantId          String
  userId            String
  purchaseOrderId   String
  storageKey        String           @db.VarChar(120)
  kind              POAttachmentKind
  originalFilename  String           @db.VarChar(200)
  declaredSizeBytes Int
  expiresAt         DateTime
  completedAt       DateTime?
  revokedAt         DateTime?
  createdAt         DateTime         @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, purchaseOrderId])
  @@map("mobile_pending_uploads")
}

model UserInvite {
  id          String    @id @default(cuid())
  tenantId    String?
  email       String
  role        Role
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("UserInviteInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([email])
  @@index([expiresAt])
  @@map("user_invites")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  targetType String?
  targetId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// Tenant-scoped customer record. Estimates link to a Client; richer
// CRM (contacts, addresses, segmentation) lands in a future phase.
// `deletedAt` enables soft-delete: list queries filter `deletedAt: null`.
model Client {
  id          String    @id @default(cuid())
  tenantId    String
  companyName String
  contactName String?
  email       String?
  phone       String?
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estimates Estimate[]

  @@index([tenantId, companyName])
  @@index([tenantId, deletedAt])
  @@map("clients")
}

// Tenant-scoped machine catalog. Rates seeded per tenant on first run
// (see apps/web/lib/estimate/seed-machines.ts and the rate table in
// docs/ai-context/ESTIMATE_ENGINE.md). Stored as integer cents per hour
// so estimate math stays integer end-to-end.
model Machine {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  ratePerHourCents Int
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  EstimateLineItem[]
  shopMaterialItems ShopMaterialItem[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("machines")
}

// One Estimate per quote. `number` is human-friendly (e.g. EST-000001),
// allocated per tenant by apps/web/lib/estimate/number.ts inside the
// same transaction that creates the row.
//
// `multiplierMilli` stores the sell multiplier × 1000 (default 3000 =
// 3.000×, R-EST-01). `designFlatCents` defaults to 15000 ($150 — the
// standard flat design fee from ESTIMATE_ENGINE.md); set to 0 to waive.
//
// `subtotalCostCents` and `finalPriceCents` are CACHED totals,
// recomputed inside the same transaction that writes line items by
// the central pricing engine in packages/pricing. List/dashboard
// views read them directly without joining EstimateLineItem.
model Estimate {
  id                String         @id @default(cuid())
  tenantId          String
  clientId          String
  number            String
  title             String
  status            EstimateStatus @default(DRAFT)
  multiplierMilli   Int            @default(3000)
  designFlatCents   Int            @default(15000)
  notes             String?
  subtotalCostCents Int            @default(0)
  finalPriceCents   Int            @default(0)
  createdById       String
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy      User               @relation("EstimateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines          EstimateLineItem[]
  purchaseOrders PurchaseOrder[]
  quoteLinks          EstimateQuoteLink[]
  timelineEvents    EstimateTimelineEvent[]

  @@unique([tenantId, number])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, clientId])
  @@index([tenantId, deletedAt])
  @@map("estimates")
}

// One row per line in the estimate grid. `qtyMilli` is the quantity ×
// 1000 (e.g. 1.500 hours = 1500), so all math stays integer and never
// drifts from floating-point. `unitCostCents` is integer cents.
// `computedCostCents` is the cached line total, refreshed by the
// pricing engine on every save.
//
// `machineId` is optional and only meaningful when `kind = MACHINE`;
// it lets the editor pre-fill `unitCostCents` from the Machine catalog
// while still allowing per-line overrides without rewriting the
// catalog rate.
model EstimateLineItem {
  id                String           @id @default(cuid())
  tenantId          String
  estimateId        String
  sortOrder         Int
  kind              EstimateLineKind
  description       String
  qtyMilli          Int              @default(1000)
  unitCostCents     Int              @default(0)
  computedCostCents Int              @default(0)
  machineId         String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  machine  Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@index([tenantId, estimateId, sortOrder])
  @@index([estimateId, sortOrder])
  @@map("estimate_line_items")
}

/// Public share token for customer-facing estimate quotes. Raw token is shown
/// once at issuance; only SHA-256 hex is stored (`tokenHash`).
model EstimateQuoteLink {
  id           String    @id @default(cuid())
  tenantId     String
  estimateId   String
  tokenHash    String    @unique
  expiresAt    DateTime?
  revokedAt    DateTime?
  lastViewedAt DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  /// Customer acceptance via public quote (exclusive with decline fields below).
  acceptedAt      DateTime?
  acceptedByName  String?
  acceptedNote    String?
  declinedAt      DateTime?
  declinedByName  String?
  declinedNote    String?
  /// First response timestamp (accept or decline).
  respondedAt DateTime?
  responseIp         String?
  responseUserAgent  String?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estimate  Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  createdBy User      @relation("QuoteLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, estimateId])
  @@map("estimate_quote_links")
}

model EstimateTimelineEvent {
  id         String               @id @default(cuid())
  tenantId   String
  estimateId String
  kind       EstimateTimelineKind
  metadata   Json?
  createdAt  DateTime             @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([tenantId, estimateId, createdAt])
  @@map("estimate_timeline_events")
}

// Tenant-scoped vendor reference. Foundation only — no contacts, no
// addresses, no pricing intelligence. Soft-deleted via deletedAt so a
// PO that references a retired vendor still resolves the name.
model Vendor {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  ingestedEmails IngestedEmail[] @relation("MatchedVendor")
  catalogItems   VendorCatalogItem[]
  itemAliases    VendorItemAlias[]
  priceHistory   VendorPriceHistory[]
  priceNotifications VendorPriceNotification[]
  spendAlerts    SpendAlert[]
  preferredForShopMaterials ShopMaterialItem[] @relation("ShopMaterialPreferredVendor")

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
  @@map("vendors")
}

// Operational handoff record. `number` is human-friendly (PO-NNNNNN),
// allocated per tenant by apps/web/lib/po/number.ts inside the same
// transaction that creates the row.
//
// `qboPoNumber` is the QuickBooks PO number entered manually after the
// user creates the PO in QuickBooks. R-EST-04: an Estimate cannot be
// FINALIZED until at least one of its linked PurchaseOrders has a
// non-null qboPoNumber.
//
// `subtotalCents` is a CACHED total (sum of line.computedCostCents),
// refreshed inside the same transaction that writes line items by
// savePoAction. List/dashboard views read it directly without joining
// POLineItem.
//
// `estimateId` is nullable: a PO can exist without a source estimate
// (rare, but supported for retro-PO entry), and we don't want deleting
// the source estimate to cascade-delete the spending record.
model PurchaseOrder {
  id            String    @id @default(cuid())
  tenantId      String
  estimateId    String?
  vendorId      String?
  number        String
  qboPoNumber   String?
  status        POStatus  @default(DRAFT)
  subtotalCents Int       @default(0)
  notes         String?
  createdById   String
  deletedAt     DateTime?
  /// Operator attestation only — does not mutate PO lines or finances.
  operatorMarkedReconciledAt   DateTime?
  operatorMarkedReconciledById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estimate    Estimate?      @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  vendor      Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdBy   User           @relation("POCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines       POLineItem[]
  attachments POAttachment[]
  events      POEvent[]
  matchedEmails IngestedEmail[] @relation("MatchedPO")
  mobilePendingUploads MobilePendingUpload[]
  reconciliations POReconciliation[]
  spendAlerts     SpendAlert[]
  operatorMarkedReconciledBy User? @relation("PoMarkedReconciledBy", fields: [operatorMarkedReconciledById], references: [id], onDelete: SetNull)

  @@unique([tenantId, number])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, estimateId])
  @@index([tenantId, vendorId])
  @@index([tenantId, qboPoNumber])
  @@index([tenantId, deletedAt])
  @@map("purchase_orders")
}

// One row per line on the PO. Mirrors EstimateLineItem so estimate→PO
// conversion is a near-direct copy. `qtyMilli` × `unitCostCents`
// (integer cents, see CODING_STANDARDS.md). `computedCostCents` is
// the cached line total, refreshed by savePoAction on every save.
model POLineItem {
  id                String     @id @default(cuid())
  tenantId          String
  purchaseOrderId   String
  sortOrder         Int
  kind              POLineKind
  description       String
  qtyMilli          Int        @default(1000)
  unitCostCents     Int        @default(0)
  computedCostCents Int        @default(0)
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  reconciliationLines POReconciliationLine[]

  @@index([tenantId, purchaseOrderId, sortOrder])
  @@index([purchaseOrderId, sortOrder])
  @@map("po_line_items")
}

// File metadata for an uploaded PO attachment. Bytes live on disk under
// /opt/bvisible/shared/uploads/<tenantId>/po/<poId>/<storageKey> with a
// random key — `originalFilename` is preserved for display only.
//
// `mimeType` is the SERVER-DETECTED type from a magic-byte sniff at
// upload time (see apps/web/lib/po/uploads.ts). The download route
// re-detects on stream so a row with a tampered DB value can never
// influence what the browser thinks it's receiving.
// `sourceEmailId` is non-null only when this attachment was created by
// the email ingestion pipeline (apps/web/lib/email-ingest/run.ts). The
// FK is SET NULL on delete so dismissing an IngestedEmail row does not
// cascade-delete the live PO file.
model POAttachment {
  id               String           @id @default(cuid())
  tenantId         String
  purchaseOrderId  String
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  kind             POAttachmentKind @default(OTHER)
  uploadedById     String
  sourceEmailId    String?
  createdAt        DateTime         @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  uploadedBy    User           @relation("POAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  sourceEmail   IngestedEmail? @relation(fields: [sourceEmailId], references: [id], onDelete: SetNull)

  ocrDocument OcrDocument?
  vendorPriceHistoriesSource VendorPriceHistory[]

  @@index([tenantId, purchaseOrderId, createdAt])
  @@index([sourceEmailId])
  @@map("po_attachments")
}

// Append-only PO timeline. Distinct from AuditLog: this is the
// human-facing operational log shown on the PO detail page. AuditLog
// remains the security-audit channel. Both are written for state
// changes that matter to operators AND auditors.
// `sourceEmailId` is non-null only for VENDOR_REPLY rows emitted by the
// ingestion pipeline. SET NULL on delete so dismissing the source email
// keeps the timeline entry (operators still want to see "vendor replied"
// even after the original IngestedEmail row is gone).
model POEvent {
  id              String      @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  kind            POEventKind
  message         String
  metadata        Json?
  actorId         String?
  sourceEmailId   String?
  createdAt       DateTime    @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  actor         User?          @relation("POEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  sourceEmail   IngestedEmail? @relation(fields: [sourceEmailId], references: [id], onDelete: SetNull)

  @@index([tenantId, purchaseOrderId, createdAt])
  @@index([purchaseOrderId, createdAt])
  @@index([sourceEmailId])
  @@map("po_events")
}

// One mailbox per tenant. The IMAP password is stored ENCRYPTED at
// rest with AES-256-GCM keyed off the INGEST_SECRET env var (see
// apps/web/lib/email-ingest/crypto.ts). A DB leak does not yield the
// password — both ciphertext + IV + auth tag are required to decrypt
// and the key is held only in process memory on the live server.
//
// `lastError*` fields are populated by the ingestion tick on failure
// and cleared on the next successful run; they drive the
// /admin/email-ingestion config card so an operator can see the
// connection state without grepping logs.
//
// `pollIntervalSeconds` is advisory: the systemd timer fires every
// 60s; the tick refuses to run for a tenant whose `lastPolledAt + N`
// is still in the future. Value clamped 30..3600 by the validator.
model TenantEmailInbox {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  host                String
  port                Int
  secure              Boolean   @default(true)
  mailbox             String    @default("INBOX")
  username            String
  passwordCipher      String                                       // base64(iv|tag|ciphertext); see crypto.ts
  pollIntervalSeconds Int       @default(60)
  enabled             Boolean   @default(true)
  lastPolledAt        DateTime?
  lastErrorAt         DateTime?
  lastErrorMessage    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_email_inboxes")
}

// One row per inbound email message we have observed. Idempotency key
// is (tenantId, messageId) — the Message-ID header from the original
// envelope. The matcher writes status + matchedPurchaseOrderId; the UI
// drives manual links / retries via dedicated server actions.
//
// We deliberately do NOT store the full HTML/text body. `bodyTextSnippet`
// is the first ~2 KB of the plain-text body (or text-extracted-from-HTML)
// for review-screen context only; vendor emails sometimes carry
// password-reset URLs or PII and we don't want a wide blast radius if
// the row leaks. `subject` and `from` are kept in full — both are
// already present in any mail-server log on the path.
model IngestedEmail {
  id                String           @id @default(cuid())
  tenantId          String
  messageId         String                                          // RFC 5322 Message-ID header
  fromAddress       String
  fromName          String?
  toAddress         String?
  subject           String
  receivedAt        DateTime                                        // envelope `Date:` header
  status            EmailIngestStatus @default(PENDING)
  matchReason       EmailMatchReason  @default(NONE)
  matchedPurchaseOrderId String?
  matchedVendorId   String?
  matchHint         String?                                         // matched token (qbo number, PO number, vendor email)
  bodyTextSnippet   String?                                         // first ~2 KB of plain text, sanitized
  hasAttachments    Boolean           @default(false)
  attachmentCount   Int               @default(0)
  errorMessage      String?
  processedAt       DateTime?                                       // set on first successful match/unmatch write
  retriedAt         DateTime?                                       // last manual retry attempt
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matchedPurchaseOrder PurchaseOrder?         @relation("MatchedPO", fields: [matchedPurchaseOrderId], references: [id], onDelete: SetNull)
  matchedVendor     Vendor?                   @relation("MatchedVendor", fields: [matchedVendorId], references: [id], onDelete: SetNull)
  attachments       IngestedEmailAttachment[]
  poAttachments     POAttachment[]
  poEvents          POEvent[]
  vendorPriceHistoryRows VendorPriceHistory[]
  vendorPriceNotifications VendorPriceNotification[]

  @@unique([tenantId, messageId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, matchedPurchaseOrderId])
  @@index([tenantId, fromAddress, createdAt])
  @@map("ingested_emails")
}

// One row per attachment carried by an IngestedEmail. Bytes live on
// disk under /opt/bvisible/shared/uploads/<tenantId>/email/<emailId>/
// keyed by a server-generated random storageKey (see
// apps/web/lib/email-ingest/storage.ts). `sha256` is the content hash;
// when an attachment is later promoted to a POAttachment the same
// bytes are re-used (no double-write to the PO directory) and the
// POAttachment row carries `sourceEmailId` pointing back here.
//
// `mimeType` is the SERVER-DETECTED magic-byte type (not the value
// from the email's MIME header). Unsupported magic bytes ⇒ the
// attachment is dropped during parse with `skipReason` recorded.
model IngestedEmailAttachment {
  id               String   @id @default(cuid())
  tenantId         String
  ingestedEmailId  String
  storageKey       String                                            // random; see uploads.ts safeExtension rules
  originalFilename String                                            // sanitized; display only
  mimeType         String                                            // server-detected
  sizeBytes        Int
  sha256           String                                            // hex; for dedupe + integrity
  skipped          Boolean  @default(false)                          // true when MIME outside allowlist
  skipReason       String?
  createdAt        DateTime @default(now())

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingestedEmail  IngestedEmail @relation(fields: [ingestedEmailId], references: [id], onDelete: Cascade)
  vendorPriceHistoryRows VendorPriceHistory[]

  @@index([tenantId, ingestedEmailId])
  @@index([sha256])
  @@map("ingested_email_attachments")
}

// Per-vendor normalized SKU / material line label. Scoped by tenant +
// vendor. Optionally linked to a tenant-level ShopMaterialItem for a
// unified Items catalog UI (same normalized key within the shop item).
// nameNormalized is produced by apps/web/lib/vendor-pricing/normalize.ts.
model VendorCatalogItem {
  id               String   @id @default(cuid())
  tenantId         String
  vendorId         String
  nameNormalized   String   @db.VarChar(400)
  shopMaterialItemId String?
  vendorSku        String?  @db.VarChar(120)
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  shopMaterialItem ShopMaterialItem? @relation(fields: [shopMaterialItemId], references: [id], onDelete: SetNull)
  aliases VendorItemAlias[]
  priceHistory VendorPriceHistory[]
  priceNotifications VendorPriceNotification[]
  ocrLineItemsMapped OcrLineItem[]

  @@unique([tenantId, vendorId, nameNormalized])
  @@index([tenantId, nameNormalized])
  @@index([tenantId, vendorId])
  @@index([tenantId, shopMaterialItemId])
  @@map("vendor_catalog_items")
}

/// Tenant-level estimating catalog item ("Items"). Links to VendorCatalogItem rows
/// for MATERIAL vendor pricing. Other kinds use internalCostCents / machine defaults.
model ShopMaterialItem {
  id                  String   @id @default(cuid())
  tenantId            String
  name                String   @db.VarChar(400)
  nameNormalized      String   @db.VarChar(400)
  kind                EstimateLineKind @default(MATERIAL)
  catalogUnit         ShopCatalogUnit @default(EACH)
  customUnitLabel     String?  @db.VarChar(40)
  internalCostCents   Int      @default(0)
  /// Markup on internal/vendor unit cost for quoting guidance, stored as percent × 1000
  /// (30000 → 30%). Sell defaults use internal/vendor cost × (1 + markup/100000) unless overridden.
  markupPercentMilli  Int      @default(0)
  defaultSellPriceCents Int?
  defaultQtyMilli     Int      @default(1000)
  machineId           String?
  notes               String?  @db.VarChar(2000)
  preferredVendorId   String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preferredVendor  Vendor? @relation("ShopMaterialPreferredVendor", fields: [preferredVendorId], references: [id], onDelete: SetNull)
  machine          Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  vendorCatalogLinks VendorCatalogItem[]
  aliases          ShopMaterialItemAlias[]

  @@unique([tenantId, nameNormalized])
  @@index([tenantId, isActive])
  @@index([tenantId, kind])
  @@index([tenantId, machineId])
  @@map("shop_material_items")
}

model ShopMaterialItemAlias {
  id                 String   @id @default(cuid())
  tenantId           String
  shopMaterialItemId String
  aliasNormalized    String   @db.VarChar(400)
  createdAt          DateTime @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shopItem ShopMaterialItem @relation(fields: [shopMaterialItemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, aliasNormalized])
  @@index([tenantId, shopMaterialItemId])
  @@map("shop_material_item_aliases")
}

// Maps alternate spellings ("ij180", "IJ180CV3") to a catalog row.
// Lookup before creating a new VendorCatalogItem (R-VEN-02-style,
// deterministic exact match only).
model VendorItemAlias {
  id                   String   @id @default(cuid())
  tenantId             String
  vendorId             String
  vendorCatalogItemId  String
  aliasNormalized      String   @db.VarChar(400)
  createdAt            DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor      Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  catalogItem VendorCatalogItem @relation(fields: [vendorCatalogItemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, vendorId, aliasNormalized])
  @@index([tenantId, vendorCatalogItemId])
  @@index([tenantId, aliasNormalized])
  @@map("vendor_item_aliases")
}

// Append-only price observations from matched vendor email extraction or,
// after operator approval, from OCR'd receipts/invoices (Phase 13).
// Idempotent replays use dedupeKey (SHA-256 hex, 64 chars) per tenant.
model VendorPriceHistory {
  id                   String                     @id @default(cuid())
  tenantId             String
  vendorId             String
  vendorCatalogItemId  String
  itemNameRaw          String                     @db.VarChar(500)
  itemNameNormalized   String                     @db.VarChar(400)
  priceCents           Int
  unit                 String?                    @db.VarChar(40)
  quantityMilli        Int?
  /// Present for email-ingestion extractions; null for OCR-approved PO uploads.
  sourceEmailId        String?
  sourceAttachmentId   String?
  /// PO attachment that was OCR'd (mobile/manual/email-promoted).
  sourcePoAttachmentId String?
  /// When this row was created from an approved OCR line item.
  ocrLineItemId        String?                    @unique
  confidence           VendorPriceConfidence
  extractionMethod     VendorPriceExtractionMethod
  dedupeKey            String                     @db.VarChar(64)
  /// Optional economic date for manual observations; falls back to createdAt when null.
  effectiveAt          DateTime?
  createdAt            DateTime                   @default(now())

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor           Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  catalogItem      VendorCatalogItem      @relation(fields: [vendorCatalogItemId], references: [id], onDelete: Cascade)
  sourceEmail      IngestedEmail?         @relation(fields: [sourceEmailId], references: [id], onDelete: SetNull)
  sourceAttachment IngestedEmailAttachment? @relation(fields: [sourceAttachmentId], references: [id], onDelete: SetNull)
  sourcePoAttachment POAttachment?        @relation(fields: [sourcePoAttachmentId], references: [id], onDelete: SetNull)
  ocrLineItem      OcrLineItem?           @relation(fields: [ocrLineItemId], references: [id], onDelete: SetNull)
  reconciliationLines POReconciliationLine[]

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, vendorCatalogItemId, createdAt])
  @@index([tenantId, vendorId, createdAt])
  @@index([sourceEmailId])
  @@map("vendor_price_histories")
}

// Dashboard notification: lower price vs prior history row for the same
// catalog item. Requires explicit dismiss — never auto-cleared (R-NOTIF-01).
model VendorPriceNotification {
  id                  String    @id @default(cuid())
  tenantId            String
  vendorId            String
  vendorCatalogItemId String
  oldPriceCents       Int
  newPriceCents       Int
  sourceEmailId       String?
  sourceOcrDocumentId String?
  dismissedAt         DateTime?
  createdAt           DateTime  @default(now())

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor             Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  catalogItem        VendorCatalogItem @relation(fields: [vendorCatalogItemId], references: [id], onDelete: Cascade)
  sourceEmail        IngestedEmail?    @relation(fields: [sourceEmailId], references: [id], onDelete: SetNull)
  sourceOcrDocument  OcrDocument?      @relation(fields: [sourceOcrDocumentId], references: [id], onDelete: SetNull)

  @@index([tenantId, dismissedAt, createdAt])
  @@index([tenantId, vendorId])
  @@map("vendor_price_notifications")
}

/// Locally OCR'd PO attachment — suggestion-only until operator confirms.
model OcrDocument {
  id        String @id @default(cuid())
  tenantId  String
  status    OcrJobStatus @default(PENDING)
  /// One OCR job per PO attachment (replay-safe enqueue).
  poAttachmentId String? @unique

  attemptCount Int       @default(0)
  lastError    String?   @db.VarChar(400)
  lockedUntil  DateTime?
  engineLabel  String    @default("tesseract.js") @db.VarChar(80)

  rawTextCharCount Int?
  /// Truncated OCR/plain-text preview for UI — never log full dumps.
  rawTextSnippet   String? @db.VarChar(8000)

  vendorNameGuess      String?   @db.VarChar(500)
  invoiceNumberGuess   String?   @db.VarChar(120)
  receiptNumberGuess   String?   @db.VarChar(120)
  subtotalCentsGuess   Int?
  taxCentsGuess        Int?
  totalCentsGuess      Int?
  documentDateGuess    DateTime?

  confirmedAt    DateTime?
  confirmedById  String?
  rejectedAt     DateTime?
  rejectedById   String?
  reviewNotes    String?   @db.VarChar(2000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  poAttachment   POAttachment? @relation(fields: [poAttachmentId], references: [id], onDelete: Cascade)
  confirmedBy    User?         @relation("OcrDocumentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  rejectedBy     User?         @relation("OcrDocumentRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  lineItems      OcrLineItem[]
  priceNotifications VendorPriceNotification[]

  @@index([tenantId, status, createdAt])
  @@map("ocr_documents")
}

/// Candidate line extracted from OCR/plain text — not pricing truth until approval.
model OcrLineItem {
  id             String @id @default(cuid())
  ocrDocumentId  String
  sortOrder      Int
  rawLineText    String @db.VarChar(2000)
  itemLabelNormalized String? @db.VarChar(400)
  quantityMilliGuess  Int?
  unitPriceCentsGuess Int?
  confidence          VendorPriceConfidence @default(LOW)
  extractionSource    String @db.VarChar(80)
  mappedVendorCatalogItemId String?

  ocrDocument   OcrDocument         @relation(fields: [ocrDocumentId], references: [id], onDelete: Cascade)
  mappedCatalog VendorCatalogItem? @relation(fields: [mappedVendorCatalogItemId], references: [id], onDelete: SetNull)
  vendorPriceHistoryRow VendorPriceHistory?

  @@index([ocrDocumentId, sortOrder])
  @@map("ocr_line_items")
}

/// Append-only reconciliation snapshot for one PO (expected PO lines vs
/// OCR_APPROVED VendorPriceHistory rows on this PO). Replay-safe via
/// @@unique([tenantId, triggerDedupeKey]).
model POReconciliation {
  id                String                 @id @default(cuid())
  tenantId          String
  purchaseOrderId   String
  status            POReconciliationStatus @default(PENDING)
  triggerDedupeKey  String                 @db.VarChar(64)
  summary           Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  resolvedAt        DateTime?
  resolvedById      String?

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  resolvedBy      User?                   @relation("POReconciliationResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  lines           POReconciliationLine[]
  spendAlerts     SpendAlert[]
  supersededSpendAlerts SpendAlert[] @relation("SpendAlertSupersededBy")

  @@unique([tenantId, triggerDedupeKey])
  @@index([tenantId, purchaseOrderId, createdAt])
  @@map("po_reconciliations")
}

model POReconciliationLine {
  id                     String                       @id @default(cuid())
  tenantId               String
  poReconciliationId     String
  sortOrder              Int                          @default(0)
  poLineItemId           String?
  vendorPriceHistoryId   String?
  match                  POReconciliationLineMatch
  expectedQtyMilli       Int?
  expectedUnitCostCents  Int?
  observedQtyMilli       Int?
  observedUnitPriceCents Int?
  priceVarianceCents     Int?
  qtyVarianceMilli       Int?
  resolution             POReconciliationLineResolution @default(NONE)
  resolvedAt             DateTime?
  resolvedById           String?

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  poReconciliation   POReconciliation   @relation(fields: [poReconciliationId], references: [id], onDelete: Cascade)
  poLineItem         POLineItem?        @relation(fields: [poLineItemId], references: [id], onDelete: SetNull)
  vendorPriceHistory VendorPriceHistory? @relation(fields: [vendorPriceHistoryId], references: [id], onDelete: SetNull)
  resolvedBy         User?              @relation("POReconciliationLineResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([poReconciliationId, sortOrder])
  @@index([tenantId, poReconciliationId])
  @@map("po_reconciliation_lines")
}

/// Operational spend / reconciliation alerts — candidates only; humans dismiss or resolve.
model SpendAlert {
  id                  String           @id @default(cuid())
  tenantId            String
  purchaseOrderId     String?
  vendorId            String?
  poReconciliationId  String?
  kind                SpendAlertKind
  status              SpendAlertStatus @default(OPEN)
  /// Deterministic cross-snapshot identity (no reconciliation id — used for supersede + audits).
  identityKey         String           @db.VarChar(64)
  title               String           @db.VarChar(200)
  body                String           @db.VarChar(900)
  dedupeKey           String           @db.VarChar(64)
  metadata            Json?
  dismissedAt         DateTime?
  dismissedById       String?
  resolvedAt          DateTime?
  resolvedById        String?
  supersededAt        DateTime?
  supersededByReconciliationId String?
  createdAt           DateTime         @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  vendor           Vendor?           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  poReconciliation POReconciliation? @relation(fields: [poReconciliationId], references: [id], onDelete: Cascade)
  supersededByReconciliation POReconciliation? @relation("SpendAlertSupersededBy", fields: [supersededByReconciliationId], references: [id], onDelete: SetNull)
  dismissedBy      User?             @relation("SpendAlertDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)
  resolvedBy       User?             @relation("SpendAlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, vendorId])
  @@index([tenantId, purchaseOrderId, status])
  @@map("spend_alerts")
}

// Lightweight per-tick observability log. One row per (tenantId, tick)
// recording how many messages we scanned/ingested/matched and any
// top-level error. Drives the inbox-config card and the tail-the-logs
// support workflow without forcing operators to grep stdout.
model EmailIngestRun {
  id            String    @id @default(cuid())
  tenantId      String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  scannedCount  Int       @default(0)
  ingestedCount Int       @default(0)
  matchedCount  Int       @default(0)
  errorCount    Int       @default(0)
  errorMessage  String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  @@map("email_ingest_runs")
}
