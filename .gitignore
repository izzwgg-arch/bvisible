# Environment variables — never commit
.env
.env.*
.env.local
.env.*.local

# Playwright (web smoke — URLs/tokens must not land in artifacts)
apps/web/playwright-report/
apps/web/test-results/

# Keys & credentials
*.pem
*.key
id_rsa
id_rsa*
id_ed25519
id_ed25519*
*.ppk
known_hosts

# Runtime artifacts (server-side or local)
# Repo-root upload staging only — do NOT blanket-ignore path segments named `uploads`
# (Next routes live under apps/web/app/api/v1/uploads/).
/uploads/
logs/
*.log

# Node / pnpm
node_modules/
.pnpm-store/
.npm/

# Build output
.next/
dist/
build/
out/
coverage/
*.tsbuildinfo
tsconfig.tsbuildinfo

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.git-commit-msg.tmp

# Local-only deploy helper scripts (keep untracked)
server-scripts/.enqueue-*.sh

# Customer reference material (not our code) + agent scratch
docs/estimate-po-redesign/reference-handoff/
.agent-*.cmd
.agent-*.log
.git-commit-message.txt
_tmp_16_*
