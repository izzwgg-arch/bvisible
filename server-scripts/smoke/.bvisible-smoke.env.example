# Operator-only smoke credentials — NEVER commit the real file.
#
# Store outside the repo:
#   Linux / macOS / Git Bash:  ~/.bvisible-smoke.env
#   Windows (PowerShell path):  %USERPROFILE%\.bvisible-smoke.env
#
# Setup (Git Bash / Linux / macOS):
#   cp server-scripts/smoke/.bvisible-smoke.env.example ~/.bvisible-smoke.env
#   chmod 600 ~/.bvisible-smoke.env
#   # edit and set BVISIBLE_ADMIN_PASSWORD (never print or commit)
#
# Setup (Windows PowerShell):
#   Copy-Item server-scripts\smoke\.bvisible-smoke.env.example $env:USERPROFILE\.bvisible-smoke.env
#   notepad $env:USERPROFILE\.bvisible-smoke.env   # set BVISIBLE_ADMIN_PASSWORD
#
# Verify (does not print password):
#   bash server-scripts/smoke/check-smoke-env.sh
#
# Agents and CI do NOT have this password — only the human operator runs browser smoke.

BVISIBLE_BASE_URL=https://vmi3270817.contaboserver.net
BVISIBLE_ADMIN_EMAIL=admin@bvisible.local
BVISIBLE_ADMIN_PASSWORD=
